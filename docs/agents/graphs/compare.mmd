---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	fetch_a(fetch_a)
	fetch_b(fetch_b)
	diff(diff)
	explain(explain)
	verify(verify)
	__end__([<p>__end__</p>]):::last
	__start__ --> fetch_a;
	__start__ --> fetch_b;
	diff --> explain;
	explain --> verify;
	fetch_a --> diff;
	fetch_b --> diff;
	verify -.-> __end__;
	verify -.-> explain;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
