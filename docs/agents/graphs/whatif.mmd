---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load(load)
	copy(copy)
	run(run)
	compare(compare)
	fallback(fallback)
	__end__([<p>__end__</p>]):::last
	__start__ --> load;
	copy --> run;
	load --> copy;
	run -.-> compare;
	run -.-> fallback;
	compare --> __end__;
	fallback --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
