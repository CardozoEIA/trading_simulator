---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	gather_facts(gather_facts)
	write(write)
	verify(verify)
	__end__([<p>__end__</p>]):::last
	__start__ --> gather_facts;
	gather_facts --> write;
	verify -.-> __end__;
	verify -.-> write;
	write --> verify;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
