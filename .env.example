# Copy this file to backend/.env and fill in the values. NEVER commit the real .env.

# Supabase project (Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-secret-service-role-key

# Direct Postgres connection used by the LangGraph checkpointer (Settings -> Database -> Connection string, "Session pooler")
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Where Ollama is running. Default is http://localhost:11434.
# In production this is the public URL of the machine that runs the local models (see README, "Deployment").
OLLAMA_HOST=http://localhost:11434

# Frontend URL(s) allowed to call the API, comma separated (production: your Vercel URL).
CORS_ORIGINS=http://localhost:4200

# Optional tracing (Langfuse). Leave the keys empty to disable it (see docs/tracing.md).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
